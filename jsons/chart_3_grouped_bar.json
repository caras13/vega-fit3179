{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "NAPLAN Numeracy Proficiency Benchmark Achievement by School Location",
    "subtitle": "Percentage of students achieving 'Strong' or 'Exceeding' proficiency standard across Year levels",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "anchor": "start"
  },
  "width": 580,
  "height": 480,
  "data": {
    "url": "data/naplan_numeracy_proficiency.csv"
  },
  "mark": {
    "type": "bar",
    "cornerRadiusTopLeft": 3,
    "cornerRadiusTopRight": 3
  },
  "encoding": {
    "x": {
      "field": "Year_Level",
      "type": "nominal",
      "title": "NAPLAN School Year Level",
      "sort": [
        "Year 3",
        "Year 5",
        "Year 7",
        "Year 9"
      ],
      "axis": {
        "labelFontSize": 12,
        "titleFontSize": 13,
        "titlePadding": 10
      }
    },
    "xOffset": {
      "field": "Subgroup"
    },
    "y": {
      "field": "Pct_Proficient",
      "type": "quantitative",
      "title": "Students Meeting Benchmark (%)",
      "scale": {
        "domain": [
          0,
          100
        ]
      },
      "axis": {
        "labelFontSize": 11,
        "titleFontSize": 13
      }
    },
    "color": {
      "field": "Subgroup",
      "type": "nominal",
      "title": "Geographic Remoteness",
      "scale": {
        "domain": [
          "Major Cities",
          "Inner Regional",
          "Outer Regional",
          "Remote & Very Remote"
        ],
        "range": [
          "#1f77b4",
          "#48cae4",
          "#f77f00",
          "#d62728"
        ]
      },
      "legend": {
        "orient": "right",
        "titleFontSize": 12,
        "labelFontSize": 11
      }
    },
    "tooltip": [
      {
        "field": "Year_Level",
        "type": "nominal",
        "title": "Year Level"
      },
      {
        "field": "Subgroup",
        "type": "nominal",
        "title": "Location Group"
      },
      {
        "field": "Pct_Proficient",
        "type": "quantitative",
        "title": "% Meeting Benchmark",
        "format": ".1f"
      }
    ]
  }
}