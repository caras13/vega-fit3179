{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "10-Year Discipline Enrolment Trends (2015–2024)",
    "subtitle": "Comparison of higher education domestic student enrolment trajectories",
    "fontSize": 15,
    "subtitleFontSize": 12,
    "anchor": "start"
  },
  "width": 520,
  "height": 480,
  "data": {"url": "data/cs_vs_eng_historical.csv"},
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "point": {"filled": true, "size": 50}
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "quantitative",
          "title": "Academic Year",
          "axis": {"format": "d", "tickCount": 5}
        },
        "y": {
          "field": "Enrolments",
          "type": "quantitative",
          "title": "Domestic Student Enrolments"
        },
        "color": {
          "field": "Discipline",
          "type": "nominal",
          "scale": {
            "domain": [
              "Computer Science & IT",
              "Engineering & Related",
              "Mathematical Sciences"
            ],
            "range": ["#0072B2", "#D55E00", "#009E73"]
          },
          "legend": {"orient": "right"}
        },
        "tooltip": [
          {"field": "Year", "type": "quantitative"},
          {"field": "Discipline", "type": "nominal"},
          {"field": "Enrolments", "type": "quantitative", "format": ","}
        ]
      }
    }
  ]
}