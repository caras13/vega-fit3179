{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "University STEM Enrolments across Australian Campuses (2024)",
  "width": 800,
  "height": 450,
  "projection": {
    "type": "equirectangular"
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e9ecef",
        "stroke": "#ffffff",
        "strokeWidth": 1.2
      }
    },
    {
      "data": {
        "url": "data/university_stem_2024.csv"
      },
      "transform": [
        {
          "filter": "datum.Total_STEM > 0"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.8,
        "stroke": "#333333",
        "strokeWidth": 0.6
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "Total_STEM",
          "type": "quantitative",
          "title": "Total STEM Enrolments",
          "scale": {
            "range": [30, 800]
          }
        },
        "color": {
          "field": "State",
          "type": "nominal",
          "title": "State / Territory",
          "scale": {
            "domain": [
              "Australian Capital Territory",
              "Multi-State",
              "New South Wales",
              "Northern Territory",
              "Queensland",
              "South Australia",
              "Tasmania",
              "Victoria",
              "Western Australia"
            ],
            "range": [
              "#0072B2",
              "#7F7F7F",
              "#009E73",
              "#D55E00",
              "#CC79A7",
              "#E69F00",
              "#56B4E9",
              "#332288",
              "#88CCEE"
            ]
          },
          "legend": {
            "orient": "right",
            "titleFontSize": 12,
            "labelFontSize": 11
          }
        },
        "tooltip": [
          {
            "field": "Institution",
            "type": "nominal",
            "title": "University"
          },
          {
            "field": "State",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "Total_STEM",
            "type": "quantitative",
            "title": "Total STEM Enrolments",
            "format": ","
          }
        ]
      }
    }
  ]
}