{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Projected STEM Industry Employment Dynamics (2020–2030)",
    "subtitle": "Streamgraph of projected employment growth (in thousands) across key STEM sectors",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "anchor": "start"
  },
  "width": 580,
  "height": 380,
  "data": {
    "url": "data/stem_employment_streamgraph.csv"
  },
  "mark": {
    "type": "area",
    "interpolate": "monotone"
  },
  "encoding": {
    "x": {
      "field": "Year",
      "type": "quantitative",
      "title": "Year",
      "axis": {
        "format": "d",
        "labelFontSize": 11,
        "titleFontSize": 13,
        "grid": false
      }
    },
    "y": {
      "field": "Employed_Thousands",
      "type": "quantitative",
      "title": "Projected Workforce (Thousands)",
      "stack": "center",
      "axis": null
    },
    "color": {
      "field": "Industry",
      "type": "nominal",
      "title": "STEM Sector",
      "scale": {
        "domain": [
          "Tech & Cyber Security",
          "Health & Biotech",
          "Clean Energy & Environment",
          "Engineering & Automation",
          "Traditional Manufacturing"
        ],
        "range": ["#0077b6", "#00b4d8", "#2a9d8f", "#e63946", "#6c757d"]
      },
      "legend": {
        "orient": "right",
        "titleFontSize": 12,
        "labelFontSize": 11
      }
    },
    "tooltip": [
      {"field": "Year", "type": "quantitative", "title": "Year"},
      {"field": "Industry", "type": "nominal", "title": "Industry Sector"},
      {"field": "Employed_Thousands", "type": "quantitative", "title": "Employed (Thousands)", "format": ",d"}
    ]
  }
}