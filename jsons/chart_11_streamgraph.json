{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Projected STEM Industry Employment Dynamics (2020–2030)",
    "subtitle": "Streamgraph of projected employment growth (in thousands) across key STEM sectors",
    "fontSize": 15,
    "subtitleFontSize": 12,
    "anchor": "start"
  },
  "width": 520,
  "height": 480,
  "data": {"url": "data/stem_employment_streamgraph.csv"},
  "mark": {"type": "area", "interpolate": "monotone"},
  "encoding": {
    "x": {
      "field": "Year",
      "type": "quantitative",
      "title": "Year",
      "axis": {"format": "d", "grid": false}
    },
    "y": {
      "field": "Employed_Thousands",
      "type": "quantitative",
      "stack": "center",
      "axis": null
    },
    "color": {
      "field": "Industry",
      "type": "nominal",
      "title": "STEM Sector",
      "scale": {
        "domain": [
          "Tech & Cyber Security",
          "Health & Biotech",
          "Clean Energy & Environment",
          "Engineering & Automation",
          "Traditional Manufacturing"
        ],
        "range": ["#0072B2", "#56B4E9", "#009E73", "#D55E00", "#999999"]
      },
      "legend": {"orient": "right"}
    },
    "tooltip": [
      {"field": "Year", "type": "quantitative"},
      {"field": "Industry", "type": "nominal"},
      {"field": "Employed_Thousands", "type": "quantitative", "format": ",d"}
    ]
  }
}